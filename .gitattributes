# Paths left out of `git archive` (scripts/release.sh) and of GitHub's
# automatic source archives. Only development files are listed here: every
# top-level *.php page, src/, public/ (the document root: index.php, mbapi.php,
# style.css, js/, icons/, .htaccess), table-schema.txt, the READMEs,
# CHANGELOG.md and composer.json/composer.lock stay in.

# Line endings: every text file of ours is LF, in the repository and in checkouts
# (the formatting pull request converted the former CRLF files). Recorded and
# fixture bytes stay exactly as they are: the import CSV fixtures are CRLF on
# purpose, and the reference recordings (tests/reference/php85/) hold the
# application output as received.
* text=auto eol=lf
/tests/fixtures/** -text
/tests/reference/fixtures/** -text
/tests/reference/php85/** -text
# Third-party files stay exactly as shipped (icons/readme.* are CRLF).
/public/icons/** -text
/public/js/** -text
# Our own chart script (the rest of js/ is vendored).
/public/js/vreport-chart.js text eol=lf

# Test harness, CI and tooling.
/tests/** export-ignore
/compose*.yaml export-ignore
/phpunit.xml export-ignore
/.github export-ignore
/scripts export-ignore
# The stylesheet source; the built public/style.css is committed and shipped.
/css export-ignore
/AGENTS.md export-ignore
/.dockerignore export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/.git-blame-ignore-revs export-ignore
/.php-cs-fixer.dist.php export-ignore
/.claude export-ignore
/.githooks export-ignore
# Host provisioning and deploy scripts (run from a checkout, not served).
/deploy export-ignore

# Command-line voucher-number check (php check.php <account> <max>).
/check.php export-ignore

# The database schema referenced by the README setup stays in. Directories
# matching an export-ignore pattern drop all of their contents, so tests/fixtures
# itself is re-included (its other entries still match /tests/**).
/tests/fixtures -export-ignore
/tests/fixtures/schema.sql -export-ignore
