<?xml version="1.0" encoding="UTF-8"?>
<!-- failOnNotice/failOnWarning: PHPUnit 10+ reports notices and warnings
     instead of failing the test; they still fail the run, as in PHPUnit 9. -->
<phpunit bootstrap="tests/phpunit-bootstrap.php"
         colors="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         failOnNotice="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
  <php>
    <!-- E_ALL, independent of php.ini. -->
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="functions.php">
      <file>tests/unit/FunctionsTest.php</file>
      <file>tests/unit/InfectionShimTest.php</file>
      <file>tests/unit/CryptoTest.php</file>
      <file>tests/unit/LoginSessionTest.php</file>
      <file>tests/unit/GetUsersTest.php</file>
      <file>tests/unit/ReceiptImportTest.php</file>
      <file>tests/unit/ImportMemberMatchTest.php</file>
      <file>tests/unit/ReceiptStorageTest.php</file>
      <file>tests/unit/ReceiptMigrationTest.php</file>
      <file>tests/unit/ReceiptMigrationCommandTest.php</file>
      <file>tests/unit/CheckCommandTest.php</file>
      <file>tests/unit/ShortOpenTagTest.php</file>
      <file>tests/unit/UnusedOutputTest.php</file>
      <file>tests/unit/AmountParsingTest.php</file>
      <file>tests/unit/DbHelpersTest.php</file>
      <file>tests/unit/YearNavTest.php</file>
    </testsuite>
  </testsuites>
  <coverage>
    <report>
      <clover outputFile="/tmp/functions-clover.xml"/>
    </report>
  </coverage>
  <source>
    <include>
      <file>check.php</file>
      <file>functions.php</file>
      <file>src/db.php</file>
      <file>src/format.php</file>
      <file>getusers.php</file>
      <file>donations.php</file>
      <file>import.php</file>
      <file>import2.php</file>
      <file>kdonations.php</file>
      <file>migrate-receipt-key.php</file>
      <file>new.php</file>
      <file>wk.php</file>
    </include>
  </source>
</phpunit>
