# Safety net only. The document root is public/ (UPGRADING.md, "Document
# root public/"), so with a correct configuration the web server never reads
# this file. If a host still serves the release root, nothing in it may be
# served: the code, constants.php, files/, backup copies and the
# command-line scripts. Deny every request.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
