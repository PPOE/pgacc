<?php
// SECRET: the sync v2 settings of pgacc (deploy/README.md, "Membership
// system"), written by deploy/ansible from the inventory on every run;
// changes made here are overwritten. A direction's keys are only present
// while it is configured; without them it refuses (internal/mbapi.php) or
// fails closed (getusers.php).
return [
{% if pgacc_sync_listen_address | default('') != '' %}
    // internal/mbapi.php: the payments for the membership system.
    'payments_token' => '{{ pgacc_payments_token }}',
    'payments_peers' => [{% for peer in pgacc_sync_peers %}'{{ peer }}'{{ ', ' if not loop.last else '' }}{% endfor %}],
{% endif %}
{% if pgacc_members_url | default('') != '' %}
    // getusers.php: the member list of the membership system.
    'members_url' => '{{ pgacc_members_url }}',
    'members_token' => '{{ pgacc_members_token }}',
    'members_cafile' => '/etc/pgacc/admidio-addons-tls.crt',
{% endif %}
];
