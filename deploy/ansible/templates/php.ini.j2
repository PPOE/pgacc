; pgacc (deploy/ansible). Managed by Ansible.
display_errors = Off
display_startup_errors = Off
log_errors = On
expose_php = Off
allow_url_include = Off
; getusers.php fetches the member list with file_get_contents() over HTTPS.
allow_url_fopen = On
cgi.fix_pathinfo = 0
date.timezone = {{ pgacc_timezone | default("UTC") }}
memory_limit = 256M
upload_max_filesize = 20M
post_max_size = 20M
