; pgacc pool (deploy/ansible). Managed by Ansible.
[pgacc]
user = pgacc
group = pgacc
listen = /run/php/pgacc-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 10
security.limit_extensions = .php
php_admin_value[error_log] = /var/log/pgacc/php-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
