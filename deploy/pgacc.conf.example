# Settings for deploy/provision.sh (KEY=VALUE, no shell code). Variables set
# in the environment win over this file. See deploy/README.md.

# Host name the reverse proxy forwards (nginx server_name). Required.
PGACC_HOSTNAME=pgacc.example.org

# production (default) or staging. Staging serves the membership stub's
# synthetic member list in place of the membership system and allows
# commit deploys.
PGACC_MODE=production

# Addresses or CIDR ranges of the TLS-terminating reverse proxy, separated by
# spaces. When set, nginx accepts only these (and 127.0.0.1/::1). Empty: no
# restriction (protect the port with a firewall instead).
#PGACC_PROXY_ADDRESSES=192.0.2.10 2001:db8::/64

#PGACC_ROOT=/srv/pgacc
#PGACC_HTTP_PORT=80
#PGACC_TIMEZONE=UTC
#PGACC_UPLOAD_MAX=20M
#PGACC_MEMORY_LIMIT=256M
#PGACC_DB_LOCALE=C.UTF-8
#PGACC_BACKUP_DIR=/var/backups/pgacc
#PGACC_BACKUP_KEEP_DAYS=14
#PGACC_KEEP_RELEASES=5
#PGACC_GITHUB_REPO=PPOE/pgacc

# 1 allows `pgacc-deploy <commit>` (default: 1 in staging, 0 in production).
#PGACC_ALLOW_COMMIT_DEPLOY=0

# Testing only: another source of the release archives and of the commit
# lookup (default: GitHub).
#PGACC_RELEASE_BASE_URL=
#PGACC_GITHUB_API_URL=
