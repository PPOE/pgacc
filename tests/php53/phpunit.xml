<?xml version="1.0" encoding="UTF-8"?>
<!-- PHPUnit 4.8 on the production-like PHP 5.3 image (tests/php53/runtime.Dockerfile).
     InfectionShimTest is not included: it tests PHP 7.4+ mutation tooling. -->
<phpunit bootstrap="../php56/bootstrap.php" colors="true">
  <php>
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="functions.php on PHP 5.3">
      <file>../unit/FunctionsTest.php</file>
    </testsuite>
  </testsuites>
</phpunit>
