<?xml version="1.0" encoding="UTF-8"?>
<!-- PHPUnit 4.8 on the production-like PHP 5.3 image (tests/php53/runtime.Dockerfile).
     Not included: InfectionShimTest (PHP 7.4+ mutation tooling), and GetUsersTest and
     ReceiptImportTest, which rely on "finally" (PHP 5.5+; http-receipts.php covers those
     call sites against the PHP 5.3 server), ShortOpenTagTest (PHP_BINARY is PHP 5.4+;
     production runs with short_open_tag On), and ReceiptMigrationCommandTest, which uses
     PHP_BINARY (PHP 5.4+). ReceiptStorageTest checks the receipt v2 format and
     ReceiptMigrationTest the migration on PHP 5.3. -->
<phpunit bootstrap="bootstrap.php" colors="true">
  <php>
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="functions.php on PHP 5.3">
      <file>../unit/FunctionsTest.php</file>
      <file>../unit/CryptoTest.php</file>
      <file>../unit/ReceiptStorageTest.php</file>
      <file>../unit/ReceiptMigrationTest.php</file>
      <file>../unit/LoginSessionTest.php</file>
    </testsuite>
  </testsuites>
</phpunit>
