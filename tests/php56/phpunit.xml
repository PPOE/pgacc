<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="bootstrap.php" colors="true">
  <php>
    <!-- E_ALL on every lane: without php.ini, PHP 7.4 hides notices from PHPUnit. -->
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="functions.php on PHP 5.6">
      <file>../unit/FunctionsTest.php</file>
      <file>../unit/InfectionShimTest.php</file>
      <file>../unit/CryptoTest.php</file>
      <file>../unit/GetUsersTest.php</file>
      <file>../unit/ReceiptImportTest.php</file>
    </testsuite>
  </testsuites>
</phpunit>
