{
  "name": "ppoe/pgacc-static-analysis-tools",
  "description": "Pinned static-analysis tools for the pgacc test harness; not an application dependency.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "phpcompatibility/php-compatibility": "10.0.0-alpha2",
    "phpcsstandards/phpcsutils": "1.2.3",
    "squizlabs/php_codesniffer": "4.0.4",
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
    "phpstan/phpstan": "2.3.1"
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.5.0"
    },
    "sort-packages": true
  }
}
