parameters:
	ignoreErrors:
		-
			message: '#^File ends with a trailing whitespace\. This may cause problems when running the code in the web browser\. Remove the closing \?\> mark or remove the whitespace\.$#'
			identifier: whitespace.fileEnd
			count: 1
			path: ../../check.php

		-
			message: '#^Variable \$i might not be defined\.$#'
			identifier: variable.undefined
			count: 3
			path: ../../check.php

		-
			message: '#^Function percent_of_bookings invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: ../../functions.php

		-
			message: '#^Regex pattern is invalid\: Compilation failed\: quantifier does not follow a repeatable item at offset 1 in pattern\: /\^\*\-\?\\d\+\(\(\\\.\|,\)\(\\d\\d\)\?\)\?\$/$#'
			identifier: regexp.pattern
			count: 1
			path: ../../functions.php

		-
			message: '#^Variable \$file_number might not be defined\.$#'
			identifier: variable.undefined
			count: 3
			path: ../../import2.php

		-
			message: '#^File ends with a trailing whitespace\. This may cause problems when running the code in the web browser\. Remove the closing \?\> mark or remove the whitespace\.$#'
			identifier: whitespace.fileEnd
			count: 1
			path: ../../index.php

		-
			message: '#^Function page_kdonations invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: ../../index.php

		-
			message: '#^Variable \$datakey might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: ../../mbapi.php

		-
			message: '#^Binary operation "\*" between \(array\<string\>\|string\) and 100\.0 results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: ../../new.php

		-
			message: '#^Variable \$file_number might not be defined\.$#'
			identifier: variable.undefined
			count: 3
			path: ../../new.php

		-
			message: '#^Variable \$voucher_number might not be defined\.$#'
			identifier: variable.undefined
			count: 2
			path: ../../new.php
