parameters:
	ignoreErrors:
		-
			message: '#^Regex pattern is invalid\: Compilation failed\: quantifier does not follow a repeatable item at offset 1 in pattern\: /\^\*\-\?\\d\+\(\(\\\.\|,\)\(\\d\\d\)\?\)\?\$/$#'
			identifier: regexp.pattern
			count: 1
			path: ../../functions.php

		-
			message: '#^Variable \$file_number might not be defined\.$#'
			identifier: variable.undefined
			count: 3
			path: ../../import2.php

		-
			message: '#^File ends with a trailing whitespace\. This may cause problems when running the code in the web browser\. Remove the closing \?\> mark or remove the whitespace\.$#'
			identifier: whitespace.fileEnd
			count: 1
			path: ../../index.php

		-
			message: '#^Variable \$datakey might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: ../../mbapi.php

		-
			message: '#^Variable \$file_number might not be defined\.$#'
			identifier: variable.undefined
			count: 3
			path: ../../new.php

		-
			message: '#^Variable \$voucher_number might not be defined\.$#'
			identifier: variable.undefined
			count: 2
			path: ../../new.php
