# Shared PHPStan rules for the application (phpstan-application.neon) and the canary
# self-test (canaries/). Changing these settings changes both, so the canaries
# keep proving that the configuration still detects the known bug classes.
parameters:
  # Level 1 adds "might not be defined" (the uninitialized $rights2 and the
  # count() crashes); level 5 adds argument types.
  level: 5
  # The application must still run on PHP 5.6, but PHPStan cannot model
  # PHP < 7.1. PHPCompatibility (phpcs.xml) covers the 5.6 floor.
  phpVersion:
    min: 70100
    max: 80599
  tmpDir: /tmp/phpstan
  scanFiles:
    - stubs.php
  # The locked application dependencies (smalot/pdfparser), read statically.
  scanDirectories:
    - ../../vendor/smalot/pdfparser/src
  reportUnmatchedIgnoredErrors: true
