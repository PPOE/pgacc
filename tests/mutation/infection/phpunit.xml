<?xml version="1.0" encoding="UTF-8"?>
<!-- PHPUnit configuration used only by Infection (tests/mutation/infection.sh).
     It runs the normal functions.php suite against the class-wrapped copy that
     tests/mutation/infection-shim.php writes to /tmp/infection-src. -->
<phpunit bootstrap="/app/tests/phpunit-bootstrap.php" colors="false" beStrictAboutTestsThatDoNotTestAnything="true">
  <php>
    <!-- E_ALL on every lane: without php.ini, PHP 7.4 hides notices from PHPUnit. -->
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="functions.php">
      <file>/app/tests/unit/FunctionsTest.php</file>
      <file>/app/tests/unit/CryptoTest.php</file>
    </testsuite>
  </testsuites>
  <coverage processUncoveredFiles="true">
    <include>
      <file>/tmp/infection-src/functions.php</file>
    </include>
  </coverage>
</phpunit>
